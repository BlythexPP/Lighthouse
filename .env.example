# Copy to .env and replace every placeholder. Never commit real secrets.
# Agents do not use API keys. These values are operator configuration only.

AAH_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me
AAH_DATABASE_URL=sqlite+aiosqlite:///./data/aah.db
# Local default. After Fly.io deploy replace with the real https://*.fly.dev URL.
AAH_PUBLIC_BASE_URL=http://127.0.0.1:8080
AAH_LOG_LEVEL=INFO
AAH_HOST=0.0.0.0
AAH_PORT=8080

# Operator fallback only. Agents negotiate enc:v2 automatically via PUT /api/v1/keys.
# Optional AES-256-GCM key: 32 bytes, base64-encoded
# python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# AAH_PAYLOAD_KEY=
# AAH_REQUIRE_ENCRYPTION=false

# AAH_WEBHOOK_REQUIRE_TLS=true
# AAH_WEBHOOK_TIMEOUT_SECONDS=10
# AAH_WEBHOOK_MAX_RETRIES=3
# AAH_RATE_LIMIT_PER_MINUTE=120
# AAH_MAX_BODY_BYTES=262144
# AAH_ENABLE_DOCS=true
